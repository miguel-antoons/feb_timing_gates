{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "feb-race-timing-dashboard",
  "version": "0.1.0",
  "identifier": "com.miguelantoons.feb-race-timing-dashboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FEB Timing Dashboard",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
      "updater": {
        "active": true,
        "dialog": true,
        "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZERUE0MENFQjFDRTk0OTkKUldTWmxNNnh6a0RxL1RPUis4aVJMM0lhSnFVZURHeWJtbG9TNEJyancraU04dHZlSmV4UU92RTIK",
        "endpoints": [
          "https://github.com/miguel-antoons/feb_timing_gates/releases/latest/download/latest.json"
        ]
      }
    }
}
